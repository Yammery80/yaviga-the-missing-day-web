rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      // Cambia el correo por el tuyo:
      return request.auth != null && request.auth.token.email == "TU_CORREO@gmail.com";
    }

    // Contador de visitas y descargas: cualquiera suma, pero solo de 1 en 1
    match /site/stats {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views','downloads'])
                    && request.resource.data.views <= 1 && request.resource.data.downloads <= 1;
      allow update: if esAdmin() || (
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views','downloads'])
                       && request.resource.data.views - resource.data.views <= 1
                       && request.resource.data.downloads - resource.data.downloads <= 1);
    }

    // Reseñas: cualquiera puede publicar (validado), solo tú puedes borrar
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','rating','comment','createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string && request.resource.data.comment.size() <= 500
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if esAdmin();
    }

    // Todo lo demás (textos, equipo): lectura pública, edición solo tuya
    match /{document=**} {
      allow read: if true;
      allow write: if esAdmin();
    }
  }
}
